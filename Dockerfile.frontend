# ─── Frontend (Vue SPA via Nginx) ────────────────────────────────────────────
FROM node:22-alpine AS builder

ARG VITE_API_BASE_URL=http://localhost:8081/api/v1

WORKDIR /app

# Use Chinese npm mirror (TUNA mirror - fast in China)
RUN npm config set registry https://registry.npmmirror.com

# Copy frontend source (context is project root)
COPY frontend/package*.json frontend/vite.config.ts frontend/tsconfig*.json ./
RUN npm install --legacy-peer-deps

COPY frontend/ .

RUN VITE_API_BASE_URL=$VITE_API_BASE_URL npm run build

# ─── Final image ────────────────────────────────────────────────────────────
FROM nginx:1.27-alpine

# Create non-root user
RUN addgroup -S app && adduser -S app -G app

# Copy pre-built dist from builder
COPY --from=builder /app/dist/ /usr/share/nginx/html/

# Copy nginx config
COPY nginx.conf /etc/nginx/nginx.conf

# Set ownership
RUN chown -R app:app /usr/share/nginx/html /var/cache/nginx /var/run && \
    chmod -R 755 /usr/share/nginx/html

USER app

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -qO- http://localhost:80/ || exit 1

CMD ["nginx", "-g", "daemon off;"]