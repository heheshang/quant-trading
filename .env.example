# ──────────── Server ────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# ──────────── Database (PostgreSQL) ────────────
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgres://quant:changeme@postgres:5432/quant_trading

# ──────────── Redis (Caching/Sessions) ────────────
REDIS_PASSWORD=changeme
REDIS_URL=redis://:changeme@redis:6379

# ──────────── JWT Auth ────────────
# IMPORTANT: Change JWT_SECRET before production! Do NOT use the placeholder value.
# The backend will refuse to start with default/weak secrets.
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_ACCESS_EXP_SECS=900
JWT_REFRESH_EXP_SECS=604800

# ──────────── Logging ────────────
LOG_LEVEL=info

# ──────────── CORS ────────────
CORS_ORIGINS=http://localhost:80,http://localhost:5173

# ──────────── Trading Execution ────────────
INITIAL_BALANCE=100000
FEE_RATE=0.001
TRADE_MODE=paper
