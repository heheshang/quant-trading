# ──────────── Server ────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# ──────────── Database (PostgreSQL) ────────────
DATABASE_URL=postgres://quant:changeme@postgres:5432/quant_trading

# ──────────── Redis (Caching/Sessions) ────────────
REDIS_URL=redis://redis:6379

# ──────────── JWT Auth ────────────
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_ACCESS_EXP_SECS=900
JWT_REFRESH_EXP_SECS=604800

# ──────────── Logging ────────────
LOG_LEVEL=info

# ──────────── CORS ────────────
CORS_ORIGINS=http://localhost:80,http://localhost:5173
