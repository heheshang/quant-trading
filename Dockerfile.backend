FROM rust:1.95-slim-bookworm AS builder

RUN sed -i 's|http://deb.debian.org/|https://mirrors.aliyun.com/|g' /etc/apt/sources.list.d/debian.sources && \
    apt-get clean && apt-get update -y

RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends pkg-config libssl-dev && \
    rm -rf /var/lib/apt/lists/*

# Configure Chinese cargo mirror
COPY backend/.cargo/config.toml /root/.cargo/config.toml

WORKDIR /app

# Copy source + lockfiles first so cargo can detect unchanged deps
COPY backend/Cargo.toml ./Cargo.toml
COPY backend/Cargo.lock ./Cargo.lock
COPY backend/src ./src

# Fetch dependencies (cached layer - only re-runs if Cargo.toml/Cargo.lock change)
RUN --mount=type=cache,target=/root/.cargo/registry/cache \
    --mount=type=cache,target=/root/.cargo/registry/index \
    --mount=type=cache,sharing=locked,target=/root/.cargo/git \
    --mount=type=cache,target=/target \
    cargo fetch

# Build the actual binary
RUN --mount=type=cache,target=/root/.cargo/registry/cache \
    --mount=type=cache,target=/root/.cargo/registry/index \
    --mount=type=cache,sharing=locked,target=/root/.cargo/git \
    --mount=type=cache,target=/target \
    cargo build --release 

# ---- Runtime Stage ----
FROM debian:bookworm-slim

RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ca-certificates libssl3 wget curl && \
    rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd -r quant && useradd -r -g quant -d /app -s /sbin/nologin quant

WORKDIR /app

COPY --from=builder /app/target/release/quant-trading-backend /app/server
RUN chown -R quant:quant /app

USER quant

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD wget -qO- http://localhost:8080/health || exit 1

CMD ["/app/server"]
