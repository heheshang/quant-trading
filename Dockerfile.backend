# ---- Builder Stage ----
FROM rust:1.95-slim-bookworm AS builder

RUN sed -i 's|http://deb.debian.org/|https://mirrors.aliyun.com/|g' /etc/apt/sources.list.d/debian.sources && \
    apt-get clean && apt-get update -y

RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends pkg-config libssl-dev && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy source + lockfiles first so cargo can detect unchanged deps
COPY backend/Cargo.toml backend/Cargo.lock* ./
COPY .cargo/config.toml .cargo/config.toml

COPY backend/src ./src

# Build dependencies only (will be cached)
RUN cargo build --release 2>/dev/null || true
# RUN cargo build --release

# Build the actual binary
RUN cargo build --release && \
    cp target/release/quant-trading-backend /app/server

# ---- Runtime Stage ----
FROM debian:bookworm-slim

RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ca-certificates libssl3 wget curl && \
    rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd -r quant && useradd -r -g quant -d /app -s /sbin/nologin quant

WORKDIR /app

COPY --from=builder /app/server .

RUN chown -R quant:quant /app

USER quant

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8080/api/v1/health || exit 1

CMD ["/app/server"]
